                    }
                  ],
                  "heading": "Swap ideas",
                  "heading_style": "subtitle",
                  "icon": "mdi:swap-horizontal-bold",
                  "type": "heading"
                },
                {
                  "content": "{%- set ideas = state_attr('sensor.flight_watcher_swap_ideas', 'ideas') or [] -%}\n{%- set marked = state_attr('sensor.flight_watcher_would_trade', 'keys') or [] -%}\n{%- if marked | count == 0 -%}\nNo trips marked. Tap a trip number on the calendar to mark one you'd trade for something better.\n{%- elif ideas | count == 0 -%}\nWatching for better trips than: **{{ marked | map('regex_replace', '\\\\|.*', '') | join(', ') }}**. Nothing better right now.\n{%- else -%}\n| Give up | For | Dates | Layover | Days | Credit | Soft | Gain | Src | Grid |\n|:--|:--|:--|:--|--:|--:|--:|:--|:-:|:--|\n{%- for i in ideas %}\n| {{ i.for_trip }} | **{{ i.pairing }}** | {{ i.dates }} | {{ i.layover if i.layover not in [none, '', '-none-'] else ('**' ~ i.turn ~ '**' if i.turn else 'turn') }} | {{ i.days }} | {{ i.credit }} | {{ i.soft }} | **{{ i.soft_gain }}** soft, {{ i.credit_gain }} cr | {{ i.src }} | {{ '**OK**' if i.grid_ok | default(false) else (i.grid | default('?')) }} |\n{%- endfor %}\n{%- endif %}\n\n<details><summary><b>Key</b></summary>\n\n- Better = soft time up 0:30+, or credit up 1:00+ without losing soft time\n- Must be legal with your trip gone: FAR OK, 11 h home rest, no VAC or blocked day\n- **Grid**: the new trip must share a day with yours, and every day you move off must be green on the reserve grid; red ideas wait and push when the grid turns green\n- **Auto swap (dry run)**: pushes what it *would* submit; nothing is ever submitted to FLICA yet\n\n</details>",
                  "entity_id": [
