                  },
                  "icon": "mdi:island",
                  "name": "Show VAC / blocked",
                  "tap_action": {
                    "action": "toggle"
                  },
                  "type": "tile"
                },
                {
                  "content": "{%- from 'flight_watcher.jinja' import pot_table, month_key -%}\n{%- set key = month_key() -%}\n{%- set sch = (state_attr('sensor.flight_watcher_schedule', 'months') or {}).get(key) -%}\n{%- set ps = (state_attr('sensor.flight_watcher_pot_count', 'pairings') or []) + (state_attr('sensor.flight_watcher_tradeboard_pickups', 'pairings') or []) -%}\n{%- set st = states('sensor.flight_watcher_state') -%}\n{%- set lc = states('sensor.flight_watcher_last_check') -%}\n{%- set t = as_datetime(lc) if lc not in ['unknown', 'unavailable'] else none -%}\n{%- set fresh = st in ['idle', 'hunting'] and t is not none and (now() - t).total_seconds() < 900 -%}\n{%- if not fresh and t -%}\n<ha-alert alert-type=\"warning\">Pot last read {{ (t | as_local).strftime('%b %-d %H:%M') }}. May be out of date until the Watcher is running again.</ha-alert>\n\n{% endif -%}\n{{ pot_table(ps, sch['items'] if sch else none, key, is_state('input_boolean.flight_watcher_show_vac_trips', 'on'), state_attr('sensor.flight_watcher_blocked_days', 'days') or []) }}\n\n<details><summary><b>Key</b></summary>\n\n- **T** after a trip = Tradeboard pickup post; the rest are the open time pot\n- **Soft**: soft time\n- **CA**: captain\n- **Fits**: no overlap with your trips or VAC\n- **FAR**: 10 h rest before and after, 30 h off in 168 h, 100 h flying in 672 h\n- **CBA rest**: legal, but under the 11 h company minimum\n- **?**: not read yet\n- Trips on VAC or blocked days are hidden: tap **Show VAC/blocked**\n- Block a day: tap it on the schedule calendar\n\n</details>",
                  "entity_id": [
                    "input_number.flight_watcher_month_offset",
                    "sensor.flight_watcher_schedule",
                    "sensor.flight_watcher_pot_count",
                    "sensor.flight_watcher_state",
                    "sensor.flight_watcher_last_check",
                    "input_boolean.flight_watcher_show_vac_trips",
                    "sensor.flight_watcher_blocked_days",
                    "sensor.flight_watcher_tradeboard_pickups"
                  ],
                  "grid_options": {
                    "columns": "full"
                  },
                  "type": "markdown"
                },
                {
                  "badges": [
                    {
                      "entity": "sensor.flight_watcher_would_trade",
                      "name": "Marked",
                      "show_name": true,
                      "show_state": true,
                      "type": "entity"
                    },
                    {
                      "color": "orange",
                      "entity": "switch.flight_watcher_auto_swap_dry_run",
                      "name": "Auto swap (dry run)",
                      "show_name": true,
                      "show_state": true,
                      "tap_action": {
                        "action": "toggle"
